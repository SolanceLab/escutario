{
  "name": "escutario",
  "description": "Escutário: a local ear for songs that measures pitch, held notes, riffs, voices, breath and arrangement and draws a listening score.",
  "version": "1.0.0",
  "author": {
    "name": "House of Solance"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "userConfig": {
    "server_url": {
      "type": "string",
      "title": "Server address",
      "description": "Where your Escutário server answers.",
      "required": true
    },
    "api_key": {
      "type": "string",
      "title": "Key",
      "description": "The key your Escutário server expects.",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "escutario": {
      "type": "http",
      "url": "${user_config.server_url}",
      "headers": {
        "Authorization": "Bearer ${user_config.api_key}"
      }
    }
  }
}
