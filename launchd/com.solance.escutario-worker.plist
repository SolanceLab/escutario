<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.solance.escutario-worker</string>
  <key>ProgramArguments</key><array>
    <string>/path/to/escutario/.venv/bin/python</string>
    <string>-m</string><string>escutario.worker</string><string>--once</string>
  </array>
  <key>WorkingDirectory</key><string>/path/to/escutario</string>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><false/>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/path/to/escutario/logs/worker.log</string>
  <key>StandardErrorPath</key><string>/path/to/escutario/logs/worker.log</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict></plist>
